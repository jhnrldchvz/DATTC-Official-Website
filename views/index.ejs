	<body>
		<%- include('partials/header') %>

		<!-- Hero Section -->
		<section
			id="home"
			class="hero"
		>
			<div class="video-loader">
				<span class="loader"></span>
			</div>

			<video
				class="hero-video"
				autoplay
				muted
				loop
			>
				<source
					src="/assets/hero_background.webm"
					type="video/webm"
				/>
			</video>
			<div
				class="parallax-layer"
				data-speed="0.3"
				data-direction="up"
				data-mouse-intensity="20"
			></div>
			<div
				class="parallax-layer"
				data-speed="0.5"
				data-direction="down"
				data-mouse-intensity="15"
			></div>
			<div class="hero-overlay"></div>
			<div class="container">
				<div class="hero-content">
					<h1>Digital Arts Technology Training Center Inc.</h1>
					<p>Unlock your potential by mastering in-demand skills in programming, animation, graphic design, and more. Embark on an inspiring journey of creativity and innovation, harnessing the latest digital tools and techniques to bring your imagination to life and thrive in the modern world</p>
					<div class="hero-btns">
						<a
							href="#contact"
							class="btn"
						>
							Enroll Now
						</a>
						<a
							href="#about"
							class="btn btn-accent"
						>
							About Us
						</a>
					</div>
				</div>
			</div>
		</section>

		<!-- About Section -->
		<section
			id="about"
			class="about"
		>
			<div class="container">
				<div class="section-title">
					<h2>About Our School</h2>
					<p>Learn about the Digital Arts Technology Training Center Inc.</p>
				</div>

				<div class="about-content">
					<div class="about-image">
						<img
							src="/assets/images/DATTCI.jpg"
							alt="School Building"
						/>
					</div>
					<div class="about-text">
						<h3>ESTABLISHED JUNE 2022</h3>
						<h2>A Tradition of Excellence</h2>
						<p>The Institution is registered with the Technical Education and Skills Development Authority (TESDA) and the Securities and Exchange Commission. Our primary purpose is to operate as an Educational Institution providing technical skills and vocational programs including specialization short courses, training, reviews, and National Certification.</p>
						<a
							href="#academics"
							class="btn"
						>
							Our Programs
						</a>
					</div>
				</div>

				<div class="why-choose-us">
					<h2>Why Choose Us?</h2>
					<p>Our commitment to excellence creates an exceptional educational experience.</p>

					<div class="core-values-container">
						<div class="core-value-card">
							<div class="core-value-icon">
								<img
									src="/assets/images/icons/vision-icon.png"
									alt="Vision"
								/>
							</div>
							<h2>Vision</h2>
							<p>To be the Leading Institution that provides world-class technical skills and quality training in the latest trends and Technology in Digital Arts, Information Technology, and Food Services.</p>
						</div>

						<div class="core-value-card">
							<div class="core-value-icon">
								<img
									src="/assets/images/icons/mission-icon.png"
									alt="Mission"
								/>
							</div>
							<h2>Mission</h2>
							<p>To teach and train students to become globally competitive individuals.</p>
						</div>

						<div class="core-value-card">
							<div class="core-value-icon">
								<img
									src="/assets/images/icons/objectives-icon.png"
									alt="Objectives"
								/>
							</div>
							<h2>Objectives</h2>
							<p>We train students in programming, animation, systems servicing, and food services technology using cutting-edge innovations. This equips them to become globally competitive professionals in dynamic international environments.</p>
						</div>
					</div>

					<h2>What Drives Us Forward</h2>
					<p>Our core values aren't just words — they're the foundation of everything we teach and everything our students become.</p>

					<!-- ── DESKTOP: hub-and-spoke radial diagram ── -->
					<div class="radial-wrap">
						<div class="radial-infographic">

							<!-- SVG layer: dashed orbit ring + spokes + junction dots -->
							<svg class="radial-svg" viewBox="0 0 640 640" xmlns="http://www.w3.org/2000/svg">
								<!-- Static base orbit circle (faint) -->
								<circle cx="320" cy="320" r="220"
									fill="none" stroke="#3498db" stroke-width="1"
									opacity="0.15"/>

								<!-- Animated dashed orbit ring -->
								<circle cx="320" cy="320" r="220"
									fill="none" stroke="#3498db" stroke-width="1.5"
									stroke-dasharray="6 6" opacity="0.45"
									style="transform-origin:320px 320px; animation: cvOrbitSpin 18s linear infinite;"/>

								<!-- Spoke lines center-rim → satellite-rim (animated draw-in) -->
								<line x1="320" y1="320" x2="320" y2="100" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.3s ease both;"/>  <!-- top        -->
								<line x1="320" y1="320" x2="510" y2="210" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.4s ease both;"/>  <!-- top-right  -->
								<line x1="320" y1="320" x2="510" y2="430" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.5s ease both;"/>  <!-- bot-right  -->
								<line x1="320" y1="320" x2="320" y2="540" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.6s ease both;"/>  <!-- bottom     -->
								<line x1="320" y1="320" x2="130" y2="430" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.5s ease both;"/>  <!-- bot-left   -->
								<line x1="320" y1="320" x2="130" y2="210" stroke="#3498db" stroke-width="2" stroke-dasharray="400" stroke-dashoffset="0" opacity="0.4" style="animation: cvSpokeIn 0.8s 0.4s ease both;"/>  <!-- top-left   -->

								<!-- Center rim junction dots (pulsing) -->
								<circle cx="320" cy="200" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.3s ease-in-out infinite;"/>
								<circle cx="424" cy="260" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.5s ease-in-out infinite;"/>
								<circle cx="424" cy="380" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.7s ease-in-out infinite;"/>
								<circle cx="320" cy="440" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.9s ease-in-out infinite;"/>
								<circle cx="216" cy="380" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.7s ease-in-out infinite;"/>
								<circle cx="216" cy="260" r="5" fill="#fff" stroke="#3498db" stroke-width="2" style="animation: cvDotPulse 2s 0.5s ease-in-out infinite;"/>

								<!-- Satellite rim junction dots -->
								<circle cx="320" cy="180" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
								<circle cx="441" cy="250" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
								<circle cx="441" cy="390" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
								<circle cx="320" cy="460" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
								<circle cx="199" cy="390" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
								<circle cx="199" cy="250" r="4" fill="#fff" stroke="#2c3e50" stroke-width="1.5" opacity="0.5"/>
							</svg>

							<!-- Center node -->
							<div class="center-node">
								<h2>CORE<br>VALUES</h2>
								<div class="center-divider"></div>
								<span class="cn-label">D · A · T · T · C · I</span>
							</div>

							<!-- Satellite 0 — top: Determined -->
							<div class="sat-node sat-0 accent-blue">
								<div class="sat-icon"><i class="fas fa-fist-raised"></i></div>
