		<!-- Academics Section -->
		<section
			id="academics"
			class="academics"
		>
			<div class="container">
				<div class="section-title">
					<h2>Academic Programs</h2>
					<p>Our comprehensive curriculum is designed to challenge and inspire students at every level.</p>
				</div>

				<div class="program-tabs">
					<button
						class="program-tab active"
						data-program="course-offered"
					>
						Course Offered
					</button>
					<button
						class="program-tab"
						data-program="special"
					>
						Institutional Certificate Courses
					</button>
					<button
						class="program-tab"
						data-program="accreditation"
					>
						Accreditation Assessment
					</button>
				</div>

				<div
					class="program-content"
					id="course-offered"
				>
					<div class="program-details">
						<div class="program-image">
							<img
								src="/assets/images/1.jpg"
								alt="High School"
							/>
						</div>
						<div class="program-info">
							<h3>Course Offered</h3>
							<p>Our specialized training programs equip students with in-demand skills through hands-on learning and industry-relevant coursework. From mastering Java programming and customer service excellence to bringing animations to life, our graduates are prepared for success in their chosen fields.</p>

							<div class="program-features">
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>2D Animation NCIII</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Contact Center Services NCII</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Programming (Java) NCIII</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Web Development NCIII*</span>
								</div>
							</div>

							<a
								href="#contact"
								class="btn"
							>
								Learn More
							</a>
						</div>
					</div>
				</div>

				<div
					class="program-content"
					id="special"
				>
					<div class="program-details">
						<div class="program-image">
							<img
								src="/assets/images/2.jpg"
								alt="Special Programs"
							/>
						</div>
						<div class="program-info">
							<h3>Institutional Certificate Courses</h3>
							<p>Our diverse training programs develop industry-ready skills in stenography, graphic design, animation, and video production. From mastering speed writing to creating stunning visuals and dynamic animations, our courses prepare students for success in creative and technical fields.</p>

							<div class="program-features">
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Stenography</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Adobe Photoshop</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Video Graphics</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Visual Graphics</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Digital Animation</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Traditional Animation</span>
								</div>
							</div>

							<a
								href="#contact"
								class="btn"
							>
								Learn More
							</a>
						</div>
					</div>
				</div>

				<div
					class="program-content"
					id="accreditation"
				>
					<div class="program-details">
						<div class="program-image">
							<img
								src="/assets/images/animation-accreditation.png"
								alt="Accreditation Assessment"
							/>
						</div>
						<div class="program-info">
							<h3>Accreditation Assessment</h3>
							<p>Our accreditation assessment programs provide nationally recognized certifications that validate your skills and competencies. These TESDA-accredited assessments ensure graduates meet industry standards and are qualified for employment in their respective fields.</p>

							<div class="program-features">
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
									<span>Animation NCII</span>
								</div>
								<div class="program-feature">
									<i class="fas fa-check-circle"></i>
